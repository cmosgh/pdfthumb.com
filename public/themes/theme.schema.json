{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdfthumb.com/themes/theme.schema.json",
  "title": "PDFThumb dashboard theme",
  "description": "A runtime theme for the dashboard (docs/theming.md). Every field is optional: an invalid or missing value falls back to the default theme, token by token.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "description": "The brand mark shown in the navbar and footer. Dark falls back to light.",
      "properties": {
        "light": {
          "type": "string",
          "description": "A same-origin path (/...) or an https:// URL.",
          "pattern": "^(/(?!/)|https://)"
        },
        "dark": {
          "type": "string",
          "description": "A same-origin path (/...) or an https:// URL.",
          "pattern": "^(/(?!/)|https://)"
        }
      }
    },
    "light": {
      "$ref": "#/$defs/tokens",
      "description": "Values for light mode. They also apply in dark mode to tokens the default dark theme does not set."
    },
    "dark": {
      "$ref": "#/$defs/tokens",
      "description": "Values for dark mode."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tokens": {
      "type": "object",
      "description": "Token values, keyed by the token name without its --pt- prefix. A token left out keeps the default theme value.",
      "additionalProperties": false,
      "properties": {
        "font-sans": {
          "type": "string",
          "description": "A CSS font-family list."
        },
        "font-mono": {
          "type": "string",
          "description": "A CSS font-family list."
        },
        "radius-sm": {
          "type": "string",
          "description": "A CSS length."
        },
        "radius-md": {
          "type": "string",
          "description": "A CSS length."
        },
        "radius-lg": {
          "type": "string",
          "description": "A CSS length."
        },
        "radius-xl": {
          "type": "string",
          "description": "A CSS length."
        },
        "page": {
          "type": "string",
          "description": "A CSS colour."
        },
        "surface": {
          "type": "string",
          "description": "A CSS colour."
        },
        "surface-raised": {
          "type": "string",
          "description": "A CSS colour."
        },
        "band": {
